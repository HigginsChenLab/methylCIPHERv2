# Personal, machine-specific Claude overrides (never shared with collaborators)
CLAUDE.local.md

# dev folder: local-only, except the two canonical docs below, which are tracked so
# CLAUDE.md's pointers resolve in a fresh clone.
#
# The decision logs are deliberately NOT tracked, as of 2026-08-12. DECISIONS.md stays
# local at full fidelity rather than being compacted, and DECISIONS.old.md was deleted.
# Do not add either back without reading the entry that took them out.
# Everything else -- legacy/, scratch.R, clock_tracker.csv, build scripts -- stays local.
dev/*
!dev/WRITING.md
!dev/to-do.md

# Python / uv
.venv/
__pycache__/
*.py[cod]
*$py.class

# Large external/sync assets (intentional)
data-raw/assets/
data-raw/methylCIPHER-meta/

# Large test fixtures (binary/generated data)
tests/testthat/fixtures/*.gz
tests/testthat/fixtures/*.csv
tests/testthat/fixtures/*.rds

